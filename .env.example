# Required in production — sign-in tokens are signed with this.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on (most hosts set this for you).
PORT=4000

NODE_ENV=production

# Where the SQLite database file lives. Point this at a mounted persistent
# volume in production, otherwise the data goes when the container is replaced.
DATA_DIR=/data

# Set to false once your team has accounts, to stop strangers registering.
ALLOW_SIGNUP=true

# Used only by `npm run seed` for the very first account.
SEED_EMAIL=admin@example.com
SEED_PASSWORD=changeme123
SEED_NAME=Project Manager
