# All of these are optional. Copy to .env only if you need to change a default.

# Signs the session cookie. If unset, one is generated on first run and kept in
# the data directory — fine for a personal install. Set it explicitly when you
# deploy to a server, or when several machines share one database.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Port the server listens on (default 8000).
PORT=8000

# Where pm.sqlite lives. Point this at a mounted volume when deploying.
DATA_DIR=

# Set to true once the app is served over HTTPS, so the session cookie is
# marked Secure. Leave unset for a local install on http://localhost.
HTTPS_ONLY=

# Set to false once your team has accounts, to stop strangers registering.
ALLOW_SIGNUP=true

# Used only by "python run.py seed" when creating the first account.
SEED_EMAIL=admin@example.com
SEED_PASSWORD=changeme123
SEED_NAME=Project Manager
